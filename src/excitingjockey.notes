L 0xAA42 velocidad_espera3         ...
C 0xAA45 el estado...
C 0xAA4C ...por la tabla
L 0xAA54 velocidad_baja            0: la velocidad baja un punto (0-4) y espera
C 0xAA58 en 0, se queda
L 0xAA5E velocidad_espera          La espera
L 0xAA64 velocidad_pon             El paso de la velocidad (0xAB1D) en el caballo del jugador
L 0xAA74 velocidad_sigue           2 o 3: si se acaba la espera, al estado 0
L 0xAA8C velocidad_igual           Sigue igual
L 0xAA93 velocidad_sube            1: el latigo sube la velocidad; en la 5, la fuerza baja
C 0xAA9A 5?
C 0xAA9F un punto mas, al estado 2
L 0xAAB0 latigo_cansa              El latigo de mas: la fuerza y las cuentas del caballo, un poco menos (0xAAFC)
L 0xAAC6 latigo_cansa_uno          ...
L 0xAACD latigo_cansa_fin          La velocidad, un punto menos
L 0xAAD0 cansa                     Una palabra menos lo de la carrera (0xAAFC), sin bajar de 0
L 0xAADC cansa_resta               ...
L 0xAAF3 cansa_pon                 ...
D 0xAAFC 0xAB05 latigo_coste  Lo que cuesta el latigo de mas en cada carrera
F 0xAAFC 9
L 0xAB05 caballo_jugador           HL = el byte del paso del caballo del jugador (0xE041 + 4 x (n - 1))
L 0xAB08 caballo_jugador_n         ...en la tabla HL
L 0xAB10 suma_a                    HL += A
D 0xAB15 0xAB27 velocidad_tablas  Los cuatro estados del latigo, los cinco pasos de la velocidad (de 0x60 a 0x84) y las tres esperas
F 0xAB15 w4,5,w2,1
L 0xAB27 latigo_pulsa              El boton 1: un latigazo (hasta 16 en cola) y el latigo del jinete
C 0xAB27 sin latigo
C 0xAB2C el boton 1?
L 0xAB38 latigo_nuevo              Una vez por pulsacion
L 0xAB56 latigo_lleno              16 ya: nada
L 0xAB5C latigo_cuentas            Las cuentas de los latigazos: cuando una llega a 0, sale de la cola y la velocidad sube
L 0xAB64 latigo_cola_uno           Una
L 0xAB6C latigo_sale               Sale: al estado 1 y la cola corre
L 0xAB86 latigo_cola               Uno menos en la cola
L 0xAB8E fuerza_jugador            La fuerza del caballo del jugador al salir (0xF0E7), para la barra
L 0xAB99 barra_cuenta              Lo que le queda: la fuerza x 63 entre la de la salida (0-63, 0xF0E6)
L 0xABBB barra_vacia               Nada
L 0xABC0 cuentas_jugador           DE = la cuenta del caballo A (0xF080 + (A - 1) x 8)
L 0xABCC premio_jinete             El premio del jinete: si su caballo llega primero o segundo, el de la carrera (0xAC01) a su dinero
C 0xABD7 el puesto
C 0xABDC primero o segundo
C 0xABE9 el dinero del jugador 1 (BCD)
C 0xABF6 a la pantalla
