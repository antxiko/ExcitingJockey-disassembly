# La tabla de saltos de 0xAA53 (jp (hl)): los bits 3-4 de 0xF0D5 eligen una de las
# cuatro primeras entradas de 0xAB15 (las dos ultimas son la misma).
0xAA54
0xAA93
0xAA74

# La tabla de ordenes de la musica (0x8308, la lee el jp (hl) de 0x81F1 con el indice
# cpl(A)*2 de un byte de orden 0xF4-0xFF): doce ordenes; 0x82A0 y 0x82A4 no las usa
# ninguna pieza de las medidas.
0x82A0
0x82A4

